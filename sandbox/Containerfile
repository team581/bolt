# syntax=docker/dockerfile:1

FROM debian:bookworm-slim

ARG MISE_VERSION=2026.8.1
ARG TARGETARCH

ENV MISE_CACHE_DIR=/mise/cache \
	MISE_CONFIG_DIR=/mise \
	MISE_DATA_DIR=/mise \
	MISE_INSTALL_PATH=/usr/local/bin/mise \
	MISE_YES=1 \
	PATH=/mise/shims:$PATH

RUN apt-get update \
	&& apt-get install --yes --no-install-recommends bash ca-certificates curl git libatomic1 python3 \
	&& rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN curl --fail --location --silent --show-error https://mise.run \
	| MISE_VERSION="$MISE_VERSION" sh

COPY mise.toml /mise/config.toml
RUN mise install \
	&& mise reshim \
	&& ln --symbolic "$(mise where java)" /opt/java

ENV JAVA_HOME=/opt/java

COPY --chmod=755 profile.sh /etc/profile.d/mise-tools.sh
COPY --chmod=755 setup.sh /usr/local/libexec/bolt-sandbox-setup
COPY repositories/offseason-2026 /opt/bolt/repositories/offseason-2026

ENV GRADLE_USER_HOME=/opt/bolt/gradle-build-home
WORKDIR /opt/bolt/repositories/offseason-2026
RUN --mount=type=cache,id=bolt-gradle-${TARGETARCH},target=/opt/bolt/gradle-build-home,sharing=locked \
	./gradlew build --no-daemon --build-cache \
	&& ./gradlew --stop \
	&& mkdir --parents /opt/bolt/gradle-dependencies /opt/bolt/gradle-home \
	&& cp --archive "$GRADLE_USER_HOME/caches/modules-2" /opt/bolt/gradle-dependencies/modules-2 \
	&& cp --archive "$GRADLE_USER_HOME/wrapper" /opt/bolt/gradle-home/wrapper \
	&& find /opt/bolt/gradle-dependencies -type f \( -name '*.lock' -o -name gc.properties \) -delete \
	&& git clean -ffdX

ENV GRADLE_RO_DEP_CACHE=/opt/bolt/gradle-dependencies \
	GRADLE_USER_HOME=/workspace/.gradle
WORKDIR /workspace

LABEL org.opencontainers.image.source="https://github.com/team581/bolt"
